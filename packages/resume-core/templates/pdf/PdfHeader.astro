---
import { icons } from "../../pdfIcons";
import type { ResumeData } from "../../schema";

interface Props {
  header: ResumeData["header"];
  currentRole?: string;
}

const { header, currentRole } = Astro.props;
---

<header class="pdf-header">
  <div class="pdf-header-contact">
    {
      header.email && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.mail} alt="" />
          </span>
          {header.email}
        </div>
      )
    }
    {
      header.phone && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.phone} alt="" />
          </span>
          {header.phone}
        </div>
      )
    }
    {
      header.linkedin && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.linkedin} alt="" />
          </span>
          {header.linkedin.replace("https://", "").replace("www.", "")}
        </div>
      )
    }
    {
      header.github && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.github} alt="" />
          </span>
          {header.github.replace("https://", "").replace("www.", "")}
        </div>
      )
    }
    {
      header.credly && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.award} alt="" />
          </span>
          {header.credly.replace("https://", "").replace("www.", "")}
        </div>
      )
    }
    {
      header.location && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.location} alt="" />
          </span>
          {header.location}
        </div>
      )
    }
    {
      header.home && (
        <div class="pdf-contact-row">
          <span class="pdf-icon-svg">
            <img src={icons.home} alt="" />
          </span>
          {header.home}
        </div>
      )
    }
  </div>
  <div class="pdf-header-identity">
    <div class="pdf-name-wrap">
      <h1 class="pdf-name">{header.name}</h1>
      <p class="pdf-title">{(header.title || currentRole || "Software Engineer").toUpperCase()}</p>
    </div>
    <div class="pdf-profile-image">
      {
        header.image ? (
          <div
            class="pdf-profile-initial"
            style="background: transparent !important; box-shadow: 0 0 10pt rgba(0, 0, 0, 0.3);"
          >
            <img
              src={header.image}
              style="width: 50pt; height: 50pt; object-fit: cover; border-radius: 50%; display: block; filter: none !important;"
              alt="Profile Image"
            />
          </div>
        ) : (
          <div class="pdf-profile-initial">
            <img
              src={icons.user}
              style="width: 40pt; height: 40pt; filter: brightness(0) invert(1);"
              alt=""
            />
          </div>
        )
      }
    </div>
  </div>
</header>
