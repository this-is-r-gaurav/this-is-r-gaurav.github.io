---
import type { ResumeData } from "../../schema";
import { computeProofMarks } from "../../proofMarks";

interface Props {
  data: ResumeData;
}

const { data } = Astro.props;
const proofMarks = computeProofMarks(data);
const hasProof = (name: string) =>
  (proofMarks[name.toLowerCase().trim()] || []).length > 0;
---

<div id="simple-resume-pdf">
  <header class="simple-pdf-header">
    <h1 class="simple-pdf-name">{data.header.name}</h1>
    <div class="simple-pdf-contact">
      {data.header.location && <span>{data.header.location}</span>}
      {
        data.header.location &&
          (data.header.email || data.header.phone || data.header.linkedin) && (
            <span>|</span>
          )
      }
      {data.header.email && <span>{data.header.email}</span>}
      {
        data.header.email && (data.header.phone || data.header.linkedin) && (
          <span>|</span>
        )
      }
      {data.header.phone && <span>{data.header.phone}</span>}
      {data.header.phone && data.header.linkedin && <span>|</span>}
      {
        data.header.linkedin && (
          <span>
            {data.header.linkedin.replace("https://", "").replace("www.", "")}
          </span>
        )
      }
    </div>
  </header>

  <main class="simple-pdf-main">
    <!-- SUMMARY -->
    {
      data.summary && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">PROFESSIONAL SUMMARY</h2>
          <div class="section-line" />
          <p class="simple-pdf-text">{data.summary}</p>
        </section>
      )
    }

    <!-- CORE COMPETENCIES -->
    {
      data.competencies && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">CORE COMPETENCIES</h2>
          <div class="section-line" />
          <p class="simple-pdf-text">
            {data.competencies.join(" • ")}
          </p>
        </section>
      )
    }

    <!-- EXPERIENCE -->
    <section class="simple-pdf-section">
      <h2 class="simple-pdf-section-title">PROFESSIONAL EXPERIENCE</h2>
      <div class="section-line"></div>
      {
        data.experience?.map((job) => (
          <div class="simple-pdf-item">
            <div class="simple-pdf-item-header">
              <span class="simple-pdf-item-role">{job.role}</span>
              <span class="simple-pdf-item-meta">
                {job.from} — {job.to}, {job.location}
              </span>
            </div>
            <div class="simple-pdf-item-company">{job.company}</div>
            <ul class="simple-pdf-list">
              {job.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- OPEN SOURCE CONTRIBUTIONS -->
    {
      data.open_source_contributions && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">OPEN SOURCE CONTRIBUTIONS</h2>
          <div class="section-line" />
          {data.open_source_contributions.map((p: any) => (
            <div class="simple-pdf-item">
              <div class="simple-pdf-item-header">
                <span class="simple-pdf-item-role">{p.name}</span>
                <span class="simple-pdf-item-meta">{p.tech.join(", ")}</span>
              </div>
              <ul class="simple-pdf-list">
                <li>{p.description}</li>
                {p.url && <li class="url-item">{p.url}</li>}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      data.projects && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">PROJECTS</h2>
          <div class="section-line" />
          {data.projects.map((group: any) => (
            <div>
              <div
                class="simple-pdf-item-company"
                style="font-weight: 700; margin-bottom: 4pt;"
              >
                {group.group}
              </div>
              {group.items.map((p: any) => (
                <div class="simple-pdf-item">
                  <div class="simple-pdf-item-header">
                    <span class="simple-pdf-item-role">{p.name}</span>
                    {(p.duration || p.url) && <span class="simple-pdf-item-meta">{p.duration || p.url}</span>}
                  </div>
                  {p.institution && <div class="simple-pdf-item-company">{p.institution}</div>}
                  <ul class="simple-pdf-list">
                    <li>
                      <strong>Tech Stack:</strong> {p.tech.join(", ")}
                    </li>
                    <li>{p.description}</li>
                    {(p.repo || p.demo) && (
                      <li class="url-item">
                        {[p.repo && `Repo: ${p.repo}`, p.demo && `Demo: ${p.demo}`].filter(Boolean).join("  ·  ")}
                      </li>
                    )}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </section>
      )
    }

    <!-- WRITING -->
    {
      data.writing && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">WRITING</h2>
          <div class="section-line" />
          {data.writing.map((w: any) => (
            <div class="simple-pdf-item">
              <div class="simple-pdf-item-header">
                <span class="simple-pdf-item-role">{w.title}</span>
                <span class="simple-pdf-item-meta">{w.date}</span>
              </div>
              <ul class="simple-pdf-list">
                <li class="url-item">{w.url}</li>
                {w.topics && <li>{w.topics.join(", ")}</li>}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    <section class="simple-pdf-section">
      <h2 class="simple-pdf-section-title">EDUCATION</h2>
      <div class="section-line"></div>
      {
        data.education?.map((e) => (
          <div class="simple-pdf-item education-item">
            <div class="simple-pdf-item-role">{e.degree}</div>
            <div class="simple-pdf-item-detail">
              {e.institution} · {e.location} · {e.from} — {e.to}
            </div>
          </div>
        ))
      }
    </section>

    <!-- SKILLS -->
    {
      data.skills && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">SKILLS</h2>
          <div class="section-line" />
          <div class="simple-pdf-skills">
            {data.skills.map((group: any) => (
              <p>
                <strong>{group.group}:</strong>{" "}
                {group.items
                  .map((s: any) => {
                    const name = typeof s === "string" ? s : s.name;
                    return hasProof(name) ? `${name} ✓` : name;
                  })
                  .join(", ")}
              </p>
            ))}
          </div>
        </section>
      )
    }

    <!-- CERTIFICATIONS -->
    {
      data.certifications && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">CERTIFICATIONS</h2>
          <div class="section-line" />
          {data.certifications.map((c: any) => (
            <div class="simple-pdf-item">
              <div class="simple-pdf-item-header">
                <span class="simple-pdf-item-role">{c.name}</span>
                <span class="simple-pdf-item-meta">{c.issuer} {c.year ? `· ${c.year}` : ""}</span>
              </div>
              {c.description && <p class="simple-pdf-text" style="margin-top: 2pt;">{c.description}</p>}
              {c.url && <div class="url-item" style="font-size: 8.5pt; color: #0000EE; margin-top: 1pt;">{c.url.replace(/^https?:\/\/(www\.)?/, "")}</div>}
            </div>
          ))}
        </section>
      )
    }

    <!-- LANGUAGES -->
    {
      data.languages && (
        <section class="simple-pdf-section">
          <h2 class="simple-pdf-section-title">LANGUAGES</h2>
          <div class="section-line" />
          <p class="simple-pdf-text">
            {data.languages.map((l: any) => `${l.name} (${l.level})`).join(" • ")}
          </p>
        </section>
      )
    }
  </main>
</div>

