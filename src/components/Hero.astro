---
import type { HeaderData, LanguageData, ExperienceData } from "../utils/schema";

interface Props {
  header: HeaderData;
  languages?: LanguageData[];
  currentJob?: ExperienceData;
  yearsOfExperience?: number;
}

const { header, languages, currentJob, yearsOfExperience } = Astro.props;
const displayName = header.fullName || header.name || "Your Name";
const nameParts = displayName.split(" ");
const lastName = nameParts.pop();
const firstName = nameParts.join(" ");

const githubHandle = header.github
  ? "@" + header.github.replace("https://github.com/", "")
  : "";
const websiteDisplay = header.website
  ? header.website.replace("https://", "")
  : "";
---

<header class="hero">
  <div class="hero__inner">
    {
      header.image && (
        <div class="hero__photo">
          <img src={header.image} alt={header.fullName || header.name} />
        </div>
      )
    }

    <div class="hero__content">
      <h1 class="hero__name">{firstName} <span>{lastName}</span></h1>

      {
        header.tagline && (
          <p class="hero__tagline">
            <span class="hero__typewriter" data-text={header.tagline}>{header.tagline}</span>
          </p>
        )
      }

      <div class="hero__links">
        {
          header.email && (
            <div class="hero__link-wrapper">
              <a href={`mailto:${header.email}`} class="hero__link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
                {header.email}
              </a>
              <button class="copy-btn" data-copy={header.email} title="Copy email address" aria-label="Copy email address">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
              </button>
            </div>
          )
        }
        {
          githubHandle && (
            <a href={header.github} class="hero__link" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </svg>
              {githubHandle}
            </a>
          )
        }
        {
          header.linkedin && (
            <a href={header.linkedin} class="hero__link" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                <rect x="2" y="9" width="4" height="12" />
                <circle cx="4" cy="4" r="2" />
              </svg>
              LinkedIn
            </a>
          )
        }
        {
          websiteDisplay && (
            <a href={header.website} class="hero__link" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="2" y1="12" x2="22" y2="12" />
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              {websiteDisplay}
            </a>
          )
        }
        {
          header.credly && (
            <a href={header.credly} class="hero__link" target="_blank" rel="noopener noreferrer" title="View Verified Badges on Credly">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="6" />
                <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11" />
              </svg>
              Credly
            </a>
          )
        }
      </div>

      <div class="hero__meta">
        {
          yearsOfExperience && (
            <span class="hero__meta-item" title="Years of professional experience">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              {yearsOfExperience}+ Years Experience
            </span>
          )
        }
        {
          header.location && (
            <span class="hero__meta-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
              {header.location}
            </span>
          )
        }
        {
          languages && languages.length > 0 && (
            <span class="hero__meta-item">
              {languages.map((l) => l.name).join(" · ")}
            </span>
          )
        }
      </div>
    </div>
  </div>
</header>

<style>
  .hero__link-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>

<script>
  // Typewriter effect (skips when user prefers reduced motion)
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const twEls = document.querySelectorAll(".hero__typewriter");

  twEls.forEach((el: any) => {
    const text = el.dataset.text;
    if (!text) return;
    if (prefersReduced) {
      el.textContent = text;
      el.style.borderColor = "transparent";
      return;
    }
    el.textContent = "";
    let i = 0;
    const speed = 40;
    const iv = setInterval(() => {
      el.textContent += text[i++];
      if (i >= text.length) {
        clearInterval(iv);
        setTimeout(() => { el.style.borderColor = "transparent"; }, 1200);
      }
    }, speed);
  });

  // Copy to clipboard handler
  document.querySelectorAll(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      e.stopPropagation();
      const val = (btn as HTMLElement).dataset.copy;
      if (!val) return;
      try {
        await navigator.clipboard.writeText(val);
        (window as any).showToast?.(`Copied to clipboard: ${val}`);
        (window as any).posthog?.capture("contact_copied", { value: val });
      } catch (err) {
        console.error("Copy failed", err);
      }
    });
  });

  // Track contact link clicks
  document.querySelectorAll(".hero__links a.hero__link").forEach((link) => {
    link.addEventListener("click", () => {
      const href = (link as HTMLAnchorElement).href;
      const type = href.startsWith("mailto:")
        ? "email"
        : href.startsWith("tel:")
          ? "phone"
          : "social";
      (window as any).posthog?.capture("contact_link_clicked", { type, href });
    });
  });
</script>
