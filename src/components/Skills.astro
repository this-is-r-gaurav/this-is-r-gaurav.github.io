---
import type { SkillsGroup } from '../utils/schema';
import type { ProofMark } from '../../packages/resume-core/proofMarks';

interface Props {
  skills: SkillsGroup[];
  proofMarks?: Record<string, ProofMark[]>;
}

const { skills, proofMarks = {} } = Astro.props;

function marksFor(skillName: string): ProofMark[] {
  return proofMarks[skillName.toLowerCase().trim()] || [];
}
---

<div class="skills-grid stagger">
  {skills.map(group => {
    const hasBars = group.items.some((s: any) => typeof s !== 'string' && s.level != null);
    return (
      <div class="reveal-scale">
        {group.group && <div class="skill-category__name">{group.group}</div>}
        {hasBars ? (
          <div class="skill-list" style={!group.group ? "margin-top: 0" : ""}>
            {group.items.map((skill: any) => {
              const skillName = typeof skill === 'string' ? skill : skill.name;
              const marks = marksFor(skillName);
              return (
                <div class="skill-item">
                  <div class="skill-label">
                    <span>
                      {skillName}
                      {marks.length > 0 && (
                        <span class="skill-proof-marks">
                          {marks.map((m) => (
                            <a
                              href={m.url}
                              class="skill-proof-mark"
                              target="_blank"
                              rel="noopener noreferrer"
                              title={m.label}
                              aria-label={m.label}
                            >
                              {m.icon}
                            </a>
                          ))}
                        </span>
                      )}
                    </span>
                    <span class="skill-level">{typeof skill === 'string' ? '' : `${skill.level}%`}</span>
                  </div>
                  <div class="skill-bar">
                    <div
                      class="skill-bar__fill"
                      data-level={typeof skill === 'string' ? '0' : skill.level}
                    ></div>
                  </div>
                </div>
              );
            })}
          </div>
        ) : (
          <div class="skill-pills">
            {group.items.map((skill: any) => {
              const skillName = typeof skill === 'string' ? skill : skill.name;
              const marks = marksFor(skillName);
              return (
                <span
                  class="skill-pill"
                  data-skill-filter={skillName}
                  role="button"
                  tabindex="0"
                  title={`Filter experience & projects by ${skillName}`}
                >
                  {skillName}
                  {marks.length > 0 && (
                    <span class="skill-proof-marks">
                      {marks.map((m) => (
                        <a
                          href={m.url}
                          class="skill-proof-mark"
                          target="_blank"
                          rel="noopener noreferrer"
                          title={m.label}
                          aria-label={m.label}
                        >
                          {m.icon}
                        </a>
                      ))}
                    </span>
                  )}
                </span>
              );
            })}
          </div>
        )}
      </div>
    );
  })}
</div>
