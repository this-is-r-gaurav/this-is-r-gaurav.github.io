---
import PostHog from "../components/posthog.astro";
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/500.css";
import "@fontsource/eb-garamond/400.css";
import "@fontsource/eb-garamond/500.css";
import "@fontsource/eb-garamond/600.css";
import "@fontsource/eb-garamond/700.css";
import "@fontsource/eb-garamond/800.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

import fs from "node:fs";
import path from "node:path";
import { resumeData as data } from "../utils/data";

// In CI, assets are generated after the Astro build — patch-meta.ts removes
// tags for missing assets as a post-build step, so we always emit them here.
const isCI = Boolean(import.meta.env.CI || process.env.GITHUB_ACTIONS);

const hasFaviconIco =
  isCI || fs.existsSync(path.join(process.cwd(), "public/favicon.ico"));
const hasFaviconPng =
  isCI || fs.existsSync(path.join(process.cwd(), "public/favicon.png"));
const hasAppleIcon =
  isCI ||
  fs.existsSync(path.join(process.cwd(), "public/apple-touch-icon.png"));
const hasOgImage =
  isCI || fs.existsSync(path.join(process.cwd(), "public/og-image.jpg"));

const rawSiteUrl = Astro.site ? Astro.site.href : Astro.url.origin;
const siteUrl = rawSiteUrl.endsWith("/") ? rawSiteUrl.slice(0, -1) : rawSiteUrl;
const shareImage = `${siteUrl}/og-image.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Theme: run synchronously before first paint to prevent flash -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("resume-theme");
        var preferred = window.matchMedia("(prefers-color-scheme: dark)")
          .matches
          ? "dark"
          : "light";
        document.documentElement.dataset.theme = saved || preferred;
      })();
    </script>
    <meta name="description" content={description || data.meta?.description} />
    <meta name="keywords" content={data.meta?.keywords} />
    <meta name="author" content={data.header.name} />

    <!-- Favicons -->
    {hasFaviconIco && <link rel="icon" href="/favicon.ico" sizes="32x32" />}
    {hasFaviconPng && <link rel="icon" href="/favicon.png" type="image/png" />}
    {
      hasAppleIcon && (
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
      )
    }

    <!-- SEO / Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={data.meta?.ogTitle ?? title} />
    <meta
      property="og:description"
      content={description ||
        data.meta?.ogDescription ||
        data.meta?.description}
    />
    {
      hasOgImage && (
        <>
          <meta property="og:image" content={shareImage} />
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta itemprop="image" content={shareImage} />
        </>
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta
      property="twitter:description"
      content={description || data.meta?.description}
    />
    {hasOgImage && <meta property="twitter:image" content={shareImage} />}

    <link rel="canonical" href={siteUrl} />

    <!-- JSON-LD -->
    {(() => {
      const knowsAbout = Array.from(
        new Set([
          ...(data.competencies || []),
          ...(data.skills?.flatMap((g) =>
            g.items.map((i: any) => (typeof i === "string" ? i : i.name)),
          ) || []),
        ]),
      );
      const schemaData = {
        "@context": "https://schema.org/",
        "@type": "Person",
        name: data.header.name,
        jobTitle: data.header.title || (data.experience?.[0]?.role ?? "Software Engineer"),
        url: siteUrl,
        sameAs: [data.header.github, data.header.linkedin].filter(Boolean),
        description: data.meta?.description,
        ...(data.experience?.[0]
          ? {
              worksFor: {
                "@type": "Organization",
                name: data.experience[0].company,
              },
            }
          : {}),
        knowsAbout,
      };
      return (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schemaData)}
        />
      );
    })()}

    <PostHog />
  </head>
  <noscript
    ><style>
      #resume-root {
        opacity: 1 !important;
      }
    </style></noscript
  >
  <body>
    <div id="resume-root" style="opacity:0">
      <slot />
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="toast">Generating PDF…</div>

    <script>
      // Global toast notification helper
      (window as any).showToast = (msg: string, duration = 2500) => {
        const toast = document.getElementById("toast");
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add("show");
        clearTimeout((toast as any)._timer);
        (toast as any)._timer = setTimeout(() => {
          toast.classList.remove("show");
        }, duration);
      };

      // Fade in page — no loader, just a clean opacity transition
      window.addEventListener("DOMContentLoaded", () => {
        const root = document.getElementById("resume-root");
        if (root) root.style.opacity = "1";
      });

      // Stagger delays — computed per child so any number of items animate correctly
      document.querySelectorAll(".stagger").forEach((container) => {
        Array.from(container.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty(
            "--stagger-delay",
            `${0.05 + i * 0.07}s`,
          );
        });
      });

      // Scroll Reveal
      const initScrollReveal = () => {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );

        document
          .querySelectorAll(".reveal, .reveal-left, .reveal-scale")
          .forEach((el) => obs.observe(el));
      };

      // Skill Bar Animation
      const initSkillBars = () => {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                const fills = e.target.querySelectorAll(".skill-bar__fill");
                fills.forEach((f) => {
                  const level = (f as HTMLElement).dataset.level || "80";
                  requestAnimationFrame(() => {
                    (f as HTMLElement).style.width = level + "%";
                  });
                });
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.2 },
        );

        document
          .querySelectorAll(".skill-category__name, .skill-list, #skills")
          .forEach((el) => obs.observe(el));
      };

      window.addEventListener("DOMContentLoaded", () => {
        initScrollReveal();
        initSkillBars();
      });
    </script>
  </body>
</html>
<style is:global>
  @import "../styles/global.css";
</style>
