---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Experience from "../components/Experience.astro";
import Skills from "../components/Skills.astro";
import Projects from "../components/Projects.astro";
import Education from "../components/Education.astro";
import Certifications from "../components/Certifications.astro";
import SectionNav from "../components/SectionNav.astro";
import Competencies from "../components/Competencies.astro";
import Fab from "../components/Fab.astro";
import ProfessionalTemplate from "../templates/pdf/ProfessionalTemplate.astro";

import { resumeData as data } from "../utils/data";

const verifiedSkills = new Set(
  (data.certifications || [])
    .filter((c: any) => Boolean(c.url && c.url.includes("credly.com")))
    .flatMap((c: any) => c.skills || [])
    .map((s: string) => s.toLowerCase().trim())
);
---

<Layout
  title={data.meta?.title || `${data.header.name} - Resume`}
  description={data.meta?.description}
>
  <SectionNav />
  <div data-current-template="professional" id="main-content-wrapper">
    <Hero
      header={data.header}
      languages={data.languages}
      currentJob={data.experience?.[0]}
      yearsOfExperience={data.yearsOfExperience}
    />

    {data.competencies && <Competencies competencies={data.competencies} />}

    <div id="filter-bar" class="filter-status-bar" style="display: none;">
      <div class="filter-status-text">
        <span>Filtering by:</span>
        <span class="filter-status-pill" id="filter-tag-label"></span>
      </div>
      <button class="filter-clear-btn" id="filter-clear-btn" type="button">✕ Clear Filter</button>
    </div>

    <main class="resume-body">

      <!-- Full-width: Summary -->
      <div class="resume-col-full">
        {data.summary && (
          <Section id="summary" title="About Me">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <p class="summary-text reveal">{data.summary}</p>
          </Section>
        )}
      </div>

      <!-- Main column: Experience, Open Source, Projects -->
      <div class="resume-col-main">
        {data.experience && (
          <Section id="experience" title="Experience">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
            <Experience jobs={data.experience} />
          </Section>
        )}

        {data.open_source_contributions && (
          <Section id="open-source" title="Open Source">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
            <Projects projects={data.open_source_contributions} />
          </Section>
        )}

        {data.projects && (
          <Section id="projects" title="Projects">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
            </svg>
            {data.projects.map((group: any) => (
              <div>
                <h3 class="group-heading">{group.group}</h3>
                <div class="projects-grid">
                  {group.items.map((p: any) => (
                    <div class="project-card reveal">
                      <div class="project-header">
                        <span class="project-name">{p.name}</span>
                        <span class="timeline-badge">{p.duration}</span>
                      </div>
                      <p class="project-desc">{p.description}</p>
                      <div class="project-tech">
                        {p.tech.map((t: string) => (
                          <span class="tech-tag">{t}</span>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </Section>
        )}
      </div>

      <!-- Sidebar: Skills, Certifications, Education -->
      <div class="resume-col-side">
        {data.skills && (
          <Section id="skills" title="Skills">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
            </svg>
            <Skills skills={data.skills} verifiedSkills={verifiedSkills} />
          </Section>
        )}

        {data.certifications && (
          <Section id="certifications" title="Certifications">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <Certifications certifications={data.certifications} />
          </Section>
        )}

        {data.education && (
          <Section id="education" title="Education">
            <svg slot="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
              <path d="M6 12v5c3 3 9 3 12 0v-5" />
            </svg>
            <Education education={data.education} />
          </Section>
        )}
      </div>

    </main>

    <Fab />

    <ProfessionalTemplate data={data} />
  </div>

  <script>
    let currentFilter: string | null = null;
    const filterBar = document.getElementById("filter-bar");
    const filterTagLabel = document.getElementById("filter-tag-label");
    const filterClearBtn = document.getElementById("filter-clear-btn");
    const mainContent = document.getElementById("main-content-wrapper");

    function setSkillFilter(skill: string | null) {
      currentFilter = skill ? skill.trim().toLowerCase() : null;

      // Toggle active visual state on chips & pills
      document.querySelectorAll("[data-skill-filter]").forEach((el) => {
        const val = (el as HTMLElement).dataset.skillFilter?.trim().toLowerCase();
        el.classList.toggle("active-filter", Boolean(currentFilter && val === currentFilter));
      });

      if (!currentFilter) {
        mainContent?.classList.remove("filter-engaged");
        if (filterBar) filterBar.style.display = "none";
        document.querySelectorAll(".timeline-item, .project-card, .cert-item").forEach((el) => {
          el.classList.remove("dimmed", "highlighted");
        });
        document.querySelectorAll(".timeline-highlight").forEach((el) => {
          el.classList.remove("highlight-text");
        });
        return;
      }

      mainContent?.classList.add("filter-engaged");
      if (filterBar && filterTagLabel) {
        filterTagLabel.textContent = skill!;
        filterBar.style.display = "flex";
      }

      // Keyword matching
      const tokens = currentFilter
        .split(/[\s·,/-]+/)
        .map((t) => t.trim().toLowerCase())
        .filter((t) => t.length > 1 && !["and", "the", "for", "with", "systems"].includes(t));

      // Filter experience items & highlights
      document.querySelectorAll(".timeline-item").forEach((item) => {
        const text = item.textContent?.toLowerCase() || "";
        const matches = tokens.some((t) => text.includes(t));
        item.classList.toggle("highlighted", matches);
        item.classList.toggle("dimmed", !matches);

        item.querySelectorAll(".timeline-highlight").forEach((h) => {
          const hText = h.textContent?.toLowerCase() || "";
          const hMatches = tokens.some((t) => hText.includes(t));
          h.classList.toggle("highlight-text", hMatches);
        });
      });

      // Filter project cards
      document.querySelectorAll(".project-card").forEach((card) => {
        const text = card.textContent?.toLowerCase() || "";
        const matches = tokens.some((t) => text.includes(t));
        card.classList.toggle("highlighted", matches);
        card.classList.toggle("dimmed", !matches);
      });

      // Filter certifications
      document.querySelectorAll(".cert-item").forEach((cert) => {
        const text = cert.textContent?.toLowerCase() || "";
        const matches = tokens.some((t) => text.includes(t));
        cert.classList.toggle("highlighted", matches);
        cert.classList.toggle("dimmed", !matches);
      });

      (window as any).posthog?.capture("skill_filtered", { skill });
    }

    // Click on filterable chips/pills
    document.addEventListener("click", (e) => {
      const target = (e.target as Element)?.closest<HTMLElement>("[data-skill-filter]");
      if (target) {
        e.preventDefault();
        const skill = target.dataset.skillFilter;
        if (currentFilter && skill?.trim().toLowerCase() === currentFilter) {
          setSkillFilter(null);
        } else if (skill) {
          setSkillFilter(skill);
        }
      }
    });

    // Keyboard navigation (Enter / Space)
    document.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        const target = (e.target as Element)?.closest<HTMLElement>("[data-skill-filter]");
        if (target) {
          e.preventDefault();
          target.click();
        }
      }
    });

    filterClearBtn?.addEventListener("click", () => {
      setSkillFilter(null);
    });
  </script>
</Layout>
